<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alpha.API.Client" Version="1.0.0-beta09"/>
    <PackageReference Include="Fanex.Caching.Redis" Version="2.2.2.1"/>
    <PackageReference Include="Fanex.Data" Version="4.2.2"/>
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.2"/>
    <PackageReference Include="Fanex.Logging" Version="2.0.1"/>
    <PackageReference Include="Telegram.Bot" Version="17.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Shared\Resources\Languages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Languages.resx</DependentUpon>
    </Compile>
    <Compile Update="Shared\Resources\SharedResource.Designer.cs">
      <DependentUpon>SharedResource.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Shared\Resources\Languages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Languages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Shared\Resources\SharedResource.resx">
      <LastGenOutput>SharedResource.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup Label="sonarqube-rules-synchronizer">
    <CodeAnalysisRuleSet>../../../.sonarlint/telegrambotcsharp.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup></Project>