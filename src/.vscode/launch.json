{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Receiver Launch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/TelegramBot.Receiver/bin/Debug/net5.0/TelegramBot.Receiver.dll",
            "args": [],
            "cwd": "${workspaceFolder}/TelegramBot.Receiver",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
            },
            "env": {
                "ASPNETCORE_URLS": "http://localhost:40926"
            }
        },
        {
            // Use IntelliSense to find out which attributes exist for C# debugging
            // Use hover for the description of the existing attributes
            // For further information visit https://github.com/OmniSharp/omnisharp-vscode/blob/master/debugger-launchjson.md
            "name": "WebAPI Launch (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // If you have changed target frameworks, make sure to update the program path.
            "program": "${workspaceFolder}/TelegramBot.WebApi/bin/Debug/net5.0/TelegramBot.WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/TelegramBot.WebApi",
            "stopAtEntry": false,
            // Enable launching a web browser when ASP.NET Core starts. For more information: https://aka.ms/VSCode-CS-LaunchJson-WebBrowser
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:40925"
            }
        },
        {
            "name": "WebAPI Launch (Production)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/TelegramBot.WebApi/bin/Debug/net5.0/TelegramBot.WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/TelegramBot.WebApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production",
                "ASPNETCORE_URLS": "http://localhost:40925"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
    ],
    "compounds": [
        {
            "name": "WebAPI + Receiver Launch (Development)",
            "configurations": ["WebAPI Launch (Development)", "Receiver Launch"]
        }
    ]
}